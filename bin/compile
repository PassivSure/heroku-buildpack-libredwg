#!/usr/bin/env bash
# Installs a prebuilt dwg2dxf (GNU LibreDWG 0.14) into the slug at vendor/libredwg/bin.
# The binary is stripped and statically linked to libredwg, built on the stack's own build image by
# .github/workflows/build-dwg2dxf.yml in https://github.com/PassivSure/heroku-buildpack-libredwg and
# published as a release there; this script only downloads it and checks its SHA-256.
# This directory is the buildpack's source in ps-rails; copy changes to that repository's root
# (release runbook, "DWG plan sets (2026-11)").
set -euo pipefail
BUILD_DIR="$1"; CACHE_DIR="$2"
VERSION=0.14
declare -A URLS=( [heroku-26]="https://github.com/PassivSure/heroku-buildpack-libredwg/releases/download/dwg2dxf-0.14-heroku-26/dwg2dxf-0.14-heroku-26.tar.gz" )
declare -A SHAS=( [heroku-26]="987835b9b394f7ef4c86821edb876a5497d2cc411a54db2ca18bff4914c496d6" )

url="${URLS[${STACK:-}]:-}"
if [ -z "$url" ]; then
  echo " !     No prebuilt dwg2dxf $VERSION for stack '${STACK:-unknown}'." >&2
  echo " !     Run the 'Build dwg2dxf' workflow in PassivSure/heroku-buildpack-libredwg for it and add it to bin/compile." >&2
  exit 1
fi
sha="${SHAS[$STACK]}"
cached="$CACHE_DIR/dwg2dxf-$sha.tar.gz"

if [ -f "$cached" ] && echo "$sha  $cached" | sha256sum -c - > /dev/null 2>&1; then
  echo "-----> Using cached dwg2dxf $VERSION"
else
  echo "-----> Downloading dwg2dxf $VERSION for $STACK"
  rm -f "$CACHE_DIR"/dwg2dxf-*.tar.gz
  mkdir -p "$CACHE_DIR"
  curl -fsSL --retry 3 -o "$cached.part" "$url"
  echo "$sha  $cached.part" | sha256sum -c -
  mv "$cached.part" "$cached"
fi

rm -rf "$BUILD_DIR/vendor/libredwg"
mkdir -p "$BUILD_DIR/vendor/libredwg" "$BUILD_DIR/.profile.d"
tar xzf "$cached" -C "$BUILD_DIR/vendor/libredwg"
cat > "$BUILD_DIR/.profile.d/libredwg.sh" <<'PROFILE'
export PATH="$HOME/vendor/libredwg/bin:$PATH"
PROFILE
"$BUILD_DIR/vendor/libredwg/bin/dwg2dxf" --version
